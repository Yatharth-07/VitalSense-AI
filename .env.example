# VitalSense AI Environment Configuration

# Application
APP_NAME=VitalSense AI
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./vitalsense.db

# AI Integration Configuration
# Supported providers: "mock", "gemini", "openai"
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
AI_REQUEST_TIMEOUT=8.0

# Clinical Validation Boundary Configuration (Permissive numeric validation limits)
GLUCOSE_MIN=10.0
GLUCOSE_MAX=1000.0
HAEMOGLOBIN_MIN=1.0
HAEMOGLOBIN_MAX=35.0
CHOLESTEROL_MIN=20.0
CHOLESTEROL_MAX=1500.0

# Frontend Configuration
API_BASE_URL=http://127.0.0.1:8000/api
